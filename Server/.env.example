# Copy to Server/.env (Vapor loads it automatically). Everything is optional:
# with nothing set, the server runs on SQLite with demo data and offline rules.

# --- Database (TencentDB for PostgreSQL in production) ---
# DATABASE_URL=postgres://laile:password@host:5432/laile
SQLITE_PATH=laile.sqlite
SEED_DEMO_DATA=true

# --- LLM: Tencent Hunyuan ---
# LLM_API_KEY=
# LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# LLM_MODEL=hunyuan-turbos-latest

# --- Voice: ElevenLabs (falls back to Tencent Cloud TTS if no key) ---
# ELEVENLABS_API_KEY=
# Voices users can pick are defined in LaileCore's CoachVoice (built-in ElevenLabs voices; free plans
# can only use built-in/own voices via the API).
# ELEVENLABS_MODEL=eleven_multilingual_v2      # pre-generated cues (quality)
# ELEVENLABS_LIVE_MODEL=eleven_flash_v2_5      # live replies + TRTC (latency)
# VOICE_CACHE_DIR=voice-cache                  # rendered audio, reused across users (persist this)

# --- Tencent Cloud (TRTC Conversational AI, Tencent TTS) ---
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
# TENCENTCLOUD_REGION=ap-singapore
# TRTC_SDK_APP_ID=
# TRTC_SDK_SECRET_KEY=
# PUBLIC_BASE_URL=https://your-domain   # TRTC calls back into /v1/voice/llm here
# TRTC_STT_LANGUAGE=en

EMERGENCY_NUMBER=995
