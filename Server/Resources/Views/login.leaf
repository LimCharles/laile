<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Laile Clinician Portal</title>
  <link rel="stylesheet" href="/css/portal.css">
</head>
<body>
  <div class="login-wrap">
    <div class="card login-card">
      <p class="brand"><span class="brand-mark">莱</span> Laile</p>
      <h1>Clinician sign in</h1>
      <p class="muted">Review your patients' camera-verified home sessions, pain reports and progress.</p>
      #if(error):<div class="error">#(error)</div>#endif
      <form class="stack" method="post" action="/portal/login">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" value="#(email)" autocomplete="username" required>
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
        <p style="margin-top:1rem"><button class="btn btn-primary" type="submit">Sign in</button></p>
      </form>
      #if(demoEmail):
      <div class="notice small">Demo clinician: <strong>#(demoEmail)</strong> · password <strong>#(demoPassword)</strong><br>
        Patients from the app's "Try the demo" appear here as "Mdm Tan (demo guest …)".</div>
      #endif
    </div>
  </div>
</body>
</html>
