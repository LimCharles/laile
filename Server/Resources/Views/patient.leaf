#extend("base"):
#export("content"):
<div class="page-head">
  <div>
    <p class="muted small"><a href="/portal">← Patients</a></p>
    <h1>#(name)</h1>
    <p class="muted">#(procedure) · #(dayLabel) · Age #(age)</p>
  </div>
  <div class="row no-print">
    <a class="btn" href="/portal/patients/#(id)/report">Pre-visit report</a>
    <form method="post" action="/portal/patients/#(id)/programs/draft"><button class="btn btn-primary" type="submit">✦ Draft program with AI</button></form>
  </div>
</div>

#if(lifecycle.discharged):
<div class="notice">Discharged #(lifecycle.dischargedOn)#if(lifecycle.dischargeNote != ""): · “#(lifecycle.dischargeNote)”#endif. The patient keeps their history and continues self-guided.</div>
#endif

#if(linked):
<div class="card live-card" id="live" data-url="/portal/patients/#(id)/live">
  <div class="row" style="justify-content:space-between">
    <h2><span class="live-dot" id="live-dot"></span> Live session</h2>
    <span class="muted small" id="live-status">Not exercising right now. This updates every 2 seconds.</span>
  </div>
  <div id="live-body" class="live-body" hidden>
    <div class="live-main"><strong id="live-exercise"></strong> <span class="muted" id="live-progress"></span></div>
    <div class="live-stats">
      <div><p class="muted small">Reps / hold</p><p class="stat" id="live-count">–</p></div>
      <div><p class="muted small">Measured</p><p class="stat" id="live-angle">–</p></div>
      <div><p class="muted small">Reports this session</p><p class="stat" id="live-reports">0</p></div>
    </div>
    <p class="small" id="live-heard"></p>
  </div>
</div>
<script>
(function () {
  const card = document.getElementById('live');
  async function poll() {
    try {
      const r = await fetch(card.dataset.url, { credentials: 'same-origin' });
      const v = await r.json();
      const on = v.live && v.update;
      document.getElementById('live-dot').classList.toggle('on', !!on);
      document.getElementById('live-body').hidden = !on;
      if (!on) { document.getElementById('live-status').textContent = 'Not exercising right now. This updates every 2 seconds.'; return; }
      const u = v.update;
      document.getElementById('live-status').textContent = 'Live · ' + u.sessionTitle;
      document.getElementById('live-exercise').textContent = u.exerciseName;
      document.getElementById('live-progress').textContent = 'exercise ' + (u.exerciseIndex + 1) + ' of ' + u.exerciseCount + ' · set ' + (u.setIndex + 1) + ' of ' + u.totalSets + ' · ' + u.phase;
      document.getElementById('live-count').textContent = u.targetHoldSeconds ? (u.holdSeconds + ' / ' + u.targetHoldSeconds + 's') : (u.reps + (u.targetReps ? ' / ' + u.targetReps : ''));
      document.getElementById('live-angle').textContent = u.angleLabel || '–';
      document.getElementById('live-reports').textContent = u.symptomsLogged;
      document.getElementById('live-heard').textContent = u.lastHeard ? '“' + u.lastHeard + '”' : '';
    } catch (e) {}
  }
  poll(); setInterval(poll, 2000);
})();
</script>
#endif

#if(!linked):
<div class="notice">Not linked yet. Give the patient invite code <span class="code">#(inviteCode)</span> — they enter it in the Laile app under Me → Link my clinician.</div>
#endif

#if(count(flags) > 0):
<div class="card">
  <h2>Needs attention</h2>
  <ul class="flags">
    #for(f in flags):<li>#(f)</li>#endfor
  </ul>
</div>
#endif

<div class="grid grid-3">
  <div class="card"><p class="muted small">Adherence</p><p class="stat" style="font-size:1.05rem">#(adherence)</p></div>
  <div class="card"><p class="muted small">Stop a set when pain is above</p><p class="stat">#(painStop)/10</p></div>
  <div class="card"><p class="muted small">Goals</p><p>#(goals)</p></div>
</div>

#if(count(charts) > 0):
<div class="grid grid-2">
  #for(c in charts):
  <div class="card">
    <div class="row" style="justify-content:space-between">
      <h3>#(c.title)</h3>
      <span><strong>#(c.latest)</strong> <span class="muted small">#(c.change)</span></span>
    </div>
    #unsafeHTML(c.svg)
    <p class="muted small">#(c.next) · Filled dots are personal bests; dashed line is the baseline.</p>
  </div>
  #endfor
</div>
#endif

<div class="grid grid-2">
  <div class="card">
    <h2>Pain &amp; symptom reports</h2>
    <p class="muted small">Captured by voice mid-exercise, with the exercise, rep and joint angle at that moment.</p>
    #if(count(symptoms) == 0):<p class="muted">None reported.</p>#endif
    #for(s in symptoms):
    <div class="symptom #if(s.isRedFlag):red#elseif(s.needsReview):review#endif">
      <div class="row" style="justify-content:space-between">
        <strong>#(s.summary)</strong>
        #if(s.needsReview):
          <form method="post" action="/portal/symptoms/#(s.id)/review" class="no-print"><button class="btn" type="submit">Mark reviewed</button></form>
        #elseif(s.reviewed):<span class="pill pill-ok">Reviewed</span>#endif
      </div>
      <blockquote>“#(s.verbatim)”</blockquote>
      <span class="muted small">#(s.when) · App action: #(s.action)</span>
    </div>
    #endfor
  </div>

  <div>
    <div class="card">
      <h2>Programs</h2>
      #if(count(programs) == 0):<p class="muted">No program yet — draft one with AI, then review and sign it.</p>#endif
      <table>
        #for(p in programs):
        <tr>
          <td><a href="/portal/programs/#(p.id)">#(p.title)</a><br><span class="muted small">v#(p.version) · drafted by #(p.draftedBy)</span></td>
          <td>#if(p.status == "signed"):<span class="pill pill-ok">signed</span>#elseif(p.status == "draft"):<span class="pill pill-warn">draft</span>#else:<span class="pill">#(p.status)</span>#endif</td>
          <td class="small muted">#(p.date)</td>
        </tr>
        #endfor
      </table>
    </div>
    <div class="card">
      <h2>Precautions</h2>
      <ul>#for(p in precautions):<li>#(p)</li>#endfor</ul>
      #if(comorbidities != ""):<p class="small"><strong>Conditions:</strong> #(comorbidities)</p>#endif
      #if(notes != ""):<p class="small"><strong>Notes:</strong> #(notes)</p>#endif
    </div>
    <div class="card">
      <h2>Medications</h2>
      <p class="muted small">Shown to the patient as entered. The app explains and reminds; it never advises on doses.</p>
      #for(m in medications):<p><strong>#(m.name)</strong> — #(m.dose) at #(m.times)<br><span class="muted small">#(m.purpose)</span></p>#endfor
    </div>
  </div>
</div>

<div class="grid grid-2">
  <div class="card">
    <h2>First-session check-in</h2>
    <p class="muted small">The patient's first session measured where they are; Lele set their working targets from it, never above what you prescribed.</p>
    #if(count(lifecycle.calibration) == 0):<p class="muted">Not done yet. Lele will prompt them.</p>#else:
    <ul>#for(c in lifecycle.calibration):<li>#(c)</li>#endfor</ul>
    <p class="muted small">Measured #(lifecycle.calibratedOn)</p>#endif
    #if(count(lifecycle.otherPrograms) > 0):
    <p class="small"><strong>Also doing:</strong> #for(o in lifecycle.otherPrograms):#(o) · #endfor</p>#endif
  </div>
  <div class="card">
    <h2>Conversation with Lele</h2>
    <p class="muted small">Check-ins, nudges and chats, including what they answered.</p>
    #if(count(lifecycle.conversation) == 0):<p class="muted">Nothing yet.</p>#endif
    <div class="convo">
    #for(m in lifecycle.conversation):
      <div class="bubble #if(m.isLele):lele#else:person#endif"><span class="muted small">#(m.who) · #(m.when)</span><br>#(m.text)#if(m.answer != ""):<br><span class="pill">Answered: #(m.answer)</span>#endif</div>
    #endfor
    </div>
  </div>
</div>

<div class="card">
  <div class="row" style="justify-content:space-between">
    <h2>Lele's notes</h2>
    <span class="muted small">Lele is Laile's coach. The patient sees these notes too.</span>
  </div>
  <p class="muted small">When something is sore or feels wrong, Lele notes it and eases that exercise next time: a smaller range or shorter holds. After 2 comfortable sessions in a row it eases back a step. Keep an exercise eased, close a note, or add your own note for Lele to follow.</p>
  #if(count(careNotes) == 0):<p class="muted">Nothing noted yet.</p>#endif
  #for(n in careNotes):
  <div class="symptom care #if(n.isActive):#if(n.isClinician):clinician#else:review#endif#endif">
    <div class="row" style="justify-content:space-between">
      <div>
        <span class="pill #if(n.isActive):pill-warn#else:pill-ok#endif">#if(n.isActive):#(n.kind)#else:Resolved#endif</span>
        #if(n.exercise != ""):<strong>#(n.exercise)</strong> · #endif#(n.summary)
      </div>
      #if(n.isActive):
      <div class="row no-print">
        #if(n.isEasing):<form method="post" action="/portal/care-notes/#(n.id)/keep"><button class="btn" type="submit">#if(n.kept):Let Lele ease back#else:Keep eased#endif</button></form>#endif
        <form method="post" action="/portal/care-notes/#(n.id)/resolve"><button class="btn" type="submit">Close</button></form>
      </div>
      #endif
    </div>
    #if(n.quote != ""):<blockquote>“#(n.quote)”</blockquote>#endif
    #if(n.adjustment != ""):<p class="small"><strong>#(n.adjustment)</strong></p>#endif
    <details class="small"><summary class="muted">History · updated #(n.updated)</summary>
      <ul class="timeline">#for(e in n.events):<li><span class="muted">#(e.when)</span> #(e.text)</li>#endfor</ul>
    </details>
  </div>
  #endfor
  #if(linked):
  <form method="post" action="/portal/patients/#(id)/care-notes" class="row no-print" style="margin-top:0.8rem">
    <input type="text" name="text" placeholder="Note for Lele and the patient, e.g. Avoid deep knee bends until review" style="flex:1" maxlength="500">
    <button class="btn" type="submit">Add note</button>
  </form>
  #endif
</div>

#if(linked):
<div class="grid grid-2 no-print">
  <form method="post" action="/portal/patients/#(id)/visit" class="card">
    <h2>Next appointment</h2>
    <p class="muted small">Lele helps the patient prepare questions two days before.</p>
    <div class="row"><input type="datetime-local" name="next_visit" value="#(lifecycle.nextVisitInput)"><button class="btn" type="submit">Save</button></div>
    #if(lifecycle.nextVisit != ""):<p class="small">Booked: #(lifecycle.nextVisit)</p>#endif
  </form>
  #if(!lifecycle.discharged):
  <form method="post" action="/portal/patients/#(id)/discharge" class="card" onsubmit="return confirm('Discharge this patient from their physio program?')">
    <h2>Discharge</h2>
    <p class="muted small">Only you can end physio. The patient keeps their history and continues self-guided.</p>
    <label class="small">Continue with (Lele suggests #(lifecycle.suggestedFollowOn))</label>
    <select name="follow_on">#for(o in lifecycle.followOnOptions):<option value="#(o.value)" #if(o.selected):selected#endif>#(o.label)</option>#endfor</select>
    <label class="small"><input type="checkbox" name="carry_precautions" checked> Keep this patient's precautions in every program</label>
    <input type="text" name="note" placeholder="Note for the patient (optional)" maxlength="300" style="width:100%;margin:0.4rem 0">
    <button class="btn" type="submit">Discharge</button>
  </form>
  #endif
</div>
#endif

<div class="card table-wrap">
  <h2>Recent sessions</h2>
  <table>
    <thead><tr><th>When</th><th>Session</th><th>Verified reps</th><th>Length</th><th>Pain</th><th>Reports</th></tr></thead>
    <tbody>
    #for(s in sessions):
      <tr><td class="small">#(s.when)</td><td>#(s.title)</td><td>#(s.reps)</td><td>#(s.duration)</td><td class="small">#(s.pain)</td><td>#if(s.symptoms > 0):<span class="pill pill-warn">#(s.symptoms)</span>#endif</td></tr>
    #endfor
    </tbody>
  </table>
</div>
#endexport
#endextend
