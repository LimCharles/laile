<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Laile Clinician Portal</title>
  <link rel="stylesheet" href="/css/portal.css">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/portal"><span class="brand-mark">莱</span> Laile <span class="muted small">Clinician portal</span></a>
    <nav>
      <a href="/portal">Patients</a>
      <a href="/portal/patients/new">New patient</a>
      <a href="/portal/streams">Streams</a>
      <span class="muted small">#(clinicianName)</span>
      <form method="post" action="/portal/logout"><button class="btn-link" type="submit">Sign out</button></form>
    </nav>
  </header>
  <main>
    #import("content")
  </main>
</body>
</html>
